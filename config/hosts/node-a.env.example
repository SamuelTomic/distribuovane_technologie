# Uzol A – hostiteľ 192.168.1.10. Vzor; reálne súbory vygeneruje scripts/new-host-configs.ps1.
NODE_ID=A
COMPOSE_PROJECT_NAME=dt-node-a
NODE_LABEL=Kino Bratislava
UI_PORT=8080
PEER_PORT=9080
PEER_NODES=B=http://192.168.1.20:9080,C=http://192.168.1.30:9080
APP_VERSION=1.0.0
# Token musí byť rovnaký na všetkých uzloch; DB heslá sú lokálne pre uzol.
REPLICATION_TOKEN=zmen-ma-rovnaky-token-na-vsetkych-uzloch
DB_PASSWORD=zmen-ma
DB_ROOT_PASSWORD=zmen-ma-root
